#btn_back {
	width: 60px;
}

#btn_back_no_review {
	width: 60px;

	/* background-color: #24946b; */
}

#label_front {
	font-size: 24px;
	font-weight: bold;
	color: #333;
}

#separator {
	background-color: #777;
	max-height: 2px;
	min-width: 400px;
	max-width: 400px;
}

