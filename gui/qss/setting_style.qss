#btn_back_setting {
	width: 60px;

	/* background-color: #24946b; */
}

#title-setting {
	font-size: 22px;
	font-weight: bold;

	padding: 20px 30px 20px, 30px;
}

#layout_form {
	background-color: white ;
	/* background-color: antiquewhite ; */

	border: 2px solid #e0e0e0;
	border-radius: 12px;
	padding: 24px;

	min-width: 550px;
	min-height: 250px;
}

#layout_form QLabel {
	font-size: 18px;
}

#layout_form QSpinBox,
#layout_form QComboBox {

	font-size: 16px;

	min-height: 28px;
	max-width: 100px;
}

#spin_new_by_day {
	max-width : 100px;
	max-height : 30px;
}

#combo_new_review_random {
	max-width : 100px;
	max-height : 30px;
}

#spin_lat {
	max-width : 100px;
	max-height : 30px;
}

#combo_new_select_random {
	max-width : 100px;
	max-height : 30px;
}

